---
import Layout from '../layouts/Layout.astro';
import { personalProfile, experiences } from '../data/resume';

const lang = 'id';
---

<Layout title="Curriculum Vitae (CV) - Rendgra Agrida">
  <div class="min-h-screen bg-slate-100 py-10 print:py-0 print:bg-white text-slate-800">
    
    <!-- Top Action Bar (Hidden on Print) -->
    <div class="max-w-4xl mx-auto px-6 mb-6 flex items-center justify-between print:hidden">
      <a href="/" class="inline-flex items-center gap-2 text-sm font-bold text-tuku-brown hover:underline">
        ← Kembali ke Portofolio
      </a>
      <div class="flex items-center gap-3">
        <a href="/en/cv" class="px-3 py-1.5 bg-white border border-slate-300 rounded-lg text-xs font-bold text-slate-700 hover:bg-slate-50">
          🇬🇧 Switch to English
        </a>
        <button 
          onclick="window.print()" 
          class="px-5 py-2 bg-tuku-brown hover:bg-tuku-dark text-white rounded-lg text-sm font-bold shadow transition-all flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
          </svg>
          Cetak / Simpan PDF
        </button>
      </div>
    </div>

    <!-- Printable Resume Paper Container -->
    <main class="max-w-4xl mx-auto bg-white p-8 md:p-14 shadow-md rounded-2xl print:shadow-none print:rounded-none print:p-0">
      
      <!-- Header / Contact Info -->
      <header class="border-b-2 border-slate-800 pb-6 mb-8">
        <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight uppercase">
          {personalProfile.name}
        </h1>
        <p class="text-lg font-bold text-tuku-brown mt-1">
          {personalProfile.title[lang]}
        </p>

        <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs md:text-sm text-slate-600 font-medium">
          <span>📍 {personalProfile.location}</span>
          <span>📞 {personalProfile.phone}</span>
          <span>✉️ <a href={`mailto:${personalProfile.email}`} class="text-tuku-brown underline">{personalProfile.email}</a></span>
          <span>🔗 <a href={personalProfile.socials.linkedin} target="_blank" class="text-tuku-brown underline">LinkedIn</a></span>
          <span>💼 <a href={personalProfile.socials.jobstreet} target="_blank" class="text-tuku-brown underline">JobStreet</a></span>
          <span>💻 <a href={personalProfile.socials.github} target="_blank" class="text-tuku-brown underline">GitHub</a></span>
        </div>
      </header>

      <!-- Professional Summary -->
      <section class="mb-8">
        <h2 class="text-base font-extrabold uppercase tracking-wider text-slate-900 border-b border-slate-200 pb-1 mb-3">
          Ringkasan Profesional
        </h2>
        <p class="text-sm leading-relaxed text-slate-700 text-justify">
          {personalProfile.summary[lang]}
        </p>
      </section>

      <!-- Technical Skills -->
      <section class="mb-8">
        <h2 class="text-base font-extrabold uppercase tracking-wider text-slate-900 border-b border-slate-200 pb-1 mb-3">
          Keahlian Teknis & Kompetensi Utama
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
          {personalProfile.skills.map((skill) => (
            <div>
              <span class="font-bold text-slate-900">{skill.category[lang]}:</span>{' '}
              <span class="text-slate-700">{skill.items.join(', ')}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Work Experience -->
      <section class="mb-8">
        <h2 class="text-base font-extrabold uppercase tracking-wider text-slate-900 border-b border-slate-200 pb-1 mb-4">
          Pengalaman Kerja Profesional
        </h2>

        <div class="space-y-6">
          {experiences.map((exp) => (
            <div class="space-y-2">
              <div class="flex flex-col md:flex-row md:items-center justify-between">
                <div>
                  <h3 class="text-base font-bold text-slate-900">{exp.role}</h3>
                  <p class="text-sm font-semibold text-tuku-brown">
                    {exp.company}
                  </p>
                </div>
                <span class="text-xs font-bold text-slate-500 mt-1 md:mt-0">
                  {exp.period[lang]}
                </span>
              </div>

              {exp.jobDesks.map((desk) => (
                <div class="pt-2 pl-3 border-l-2 border-slate-200 text-xs md:text-sm">
                  <h4 class="font-bold text-slate-800 mb-1">{desk.title[lang]}</h4>
                  
                  <ul class="list-disc list-outside ml-4 space-y-1 text-slate-700">
                    {desk.tasks[lang].map((task) => (
                      <li>{task}</li>
                    ))}
                  </ul>

                  <div class="mt-2 bg-slate-50 p-2.5 rounded print:bg-transparent print:p-0">
                    <span class="font-bold text-slate-800">Pencapaian: </span>
                    <span class="text-slate-600">{desk.achievements[lang].join('; ')}</span>
                  </div>
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>

    </main>

  </div>
</Layout>

<style>
  @media print {
    body {
      background: white !important;
      color: black !important;
    }
  }
</style>
