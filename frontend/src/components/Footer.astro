---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { personalProfile } from '../data/resume';
import { FooterTrigger } from './FooterTrigger';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-[#2D251F] text-[#EFEBE4] py-16 mt-auto border-t border-[#44382F]">
  <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
    
    <div>
      <h3 class="text-2xl font-bold text-white mb-2">{t('footer.title')}</h3>
      <div class="text-[#C8BFAF] space-y-1 text-sm">
        <p>📍 {personalProfile.location}</p>
        <p>📞 {personalProfile.phone}</p>
        <p>✉️ <a href={`mailto:${personalProfile.email}`} class="text-[#D4AF37] hover:underline font-medium">{personalProfile.email}</a></p>
      </div>
    </div>

    <div>
      <h4 class="font-bold text-xs uppercase tracking-wider text-[#A89F90] mb-3">{t('footer.socials')}</h4>
      <div class="flex flex-wrap gap-2.5 text-xs font-bold">
        <a 
          href={personalProfile.socials.linkedin} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="bg-[#3D332A] hover:bg-[#4E4136] text-white px-3.5 py-2.5 rounded-xl border border-white/10 transition-all flex items-center gap-2 shadow-sm hover:scale-105"
          title="LinkedIn Profile"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
          </svg>
          <span>LinkedIn</span>
        </a>
        <a 
          href={personalProfile.socials.jobstreet} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="bg-[#3D332A] hover:bg-[#4E4136] text-white px-3.5 py-2.5 rounded-xl border border-white/10 transition-all flex items-center gap-2 shadow-sm hover:scale-105"
          title="JobStreet Profile"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="14" x="2" y="7" rx="2" ry="2"/>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
          </svg>
          <span>JobStreet</span>
        </a>
        <a 
          href={personalProfile.socials.github} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="bg-[#3D332A] hover:bg-[#4E4136] text-white px-3.5 py-2.5 rounded-xl border border-white/10 transition-all flex items-center gap-2 shadow-sm hover:scale-105"
          title="GitHub Profile"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>

  </div>

  <div class="max-w-5xl mx-auto px-6 mt-12 pt-8 border-t border-[#44382F] text-center">
    <FooterTrigger client:load lang={lang} />
  </div>
</footer>
