---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { personalProfile } from '../data/resume';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="bg-[#2D251F] text-[#EFEBE4] py-16 mt-auto border-t border-[#44382F]">
  <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
    
    <div>
      <h3 class="text-2xl font-bold text-white mb-2">{t('footer.title')}</h3>
      <div class="text-[#C8BFAF] space-y-1 text-sm">
        <p>📍 {personalProfile.location}</p>
        <p>📞 {personalProfile.phone}</p>
        <p>✉️ <a href={`mailto:${personalProfile.email}`} class="text-[#D4AF37] hover:underline font-medium">{personalProfile.email}</a></p>
      </div>
    </div>

    <div>
      <h4 class="font-bold text-xs uppercase tracking-wider text-[#A89F90] mb-3">{t('footer.socials')}</h4>
      <div class="flex flex-wrap gap-2 text-xs">
        <a 
          href={personalProfile.socials.linkedin} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="bg-[#3D332A] hover:bg-[#4E4136] text-white px-3 py-2 rounded-xl border border-white/10 transition-all flex items-center gap-1.5 shadow-sm"
        >
          <span>LinkedIn (rendgra-a)</span> ↗
        </a>
        <a 
          href={personalProfile.socials.jobstreet} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="bg-[#3D332A] hover:bg-[#4E4136] text-white px-3 py-2 rounded-xl border border-white/10 transition-all flex items-center gap-1.5 shadow-sm"
        >
          <span>JobStreet (rendgra-agrida)</span> ↗
        </a>
        <a 
          href={personalProfile.socials.github} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="bg-[#3D332A] hover:bg-[#4E4136] text-white px-3 py-2 rounded-xl border border-white/10 transition-all flex items-center gap-1.5 shadow-sm"
        >
          <span>GitHub (rendgraagrida)</span> ↗
        </a>
      </div>
    </div>

  </div>

  <div class="max-w-5xl mx-auto px-6 mt-12 pt-8 border-t border-[#44382F] text-center text-xs text-[#8E8373]">
    &copy; {year} Rendgra Agrida. {t('footer.made')}
  </div>
</footer>
